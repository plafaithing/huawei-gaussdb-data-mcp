# 安全开关（代码级默认：只读、不开 DDL）
GAUSSDB_DATA_MCP_READ_ONLY=true
GAUSSDB_DATA_MCP_ENABLE_DDL=false
# 文件（凭证/tokens/guardrails/审计）
GAUSSDB_DATA_MCP_CREDENTIALS_FILE=./credentials.json
GAUSSDB_DATA_MCP_TOKENS_FILE=./tokens.json
# GAUSSDB_DATA_MCP_GUARDRAILS_CONFIG=./guardrails.yaml
# GAUSSDB_DATA_MCP_AUDIT_FILE=./audit.jsonl
# HTTP 监听（默认 127.0.0.1:8000；非回环必须配置 tokens 文件）
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
# 资源限制
GAUSSDB_DATA_MCP_MAX_ROWS=200
GAUSSDB_DATA_MCP_STATEMENT_TIMEOUT_MS=30000
